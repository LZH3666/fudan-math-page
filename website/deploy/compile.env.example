# Only the compile broker reads this file. It never receives SMTP credentials.
FUDAN_WORKER_PORT=4322
FUDAN_COMPILE_TOKEN_FILE=/etc/fudan-math/compile-token
# Replace with the exact image ID recorded after the tested build.
FUDAN_TEX_IMAGE=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
FUDAN_DOCKER=/usr/bin/docker
