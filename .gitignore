# The working directory also contains original course materials and operational data.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/website/

/website/*
!/website/.gitignore
!/website/*.mjs
!/website/package.json
!/website/package-lock.json
!/website/dist/
!/website/banana-runtime/
!/website/deploy/
!/website/readonly-template/
!/website/scripts/
!/website/tests/

/website/dist/*
!/website/dist/*.js
!/website/dist/*.mjs
!/website/dist/index.html
!/website/dist/style.css
!/website/dist/vendor/
/website/dist/vendor/*
!/website/dist/vendor/pypinyin-LICENSE.txt

/website/banana-runtime/*
!/website/banana-runtime/LICENSE
!/website/banana-runtime/UPSTREAM.md
!/website/banana-runtime/hugo.toml
!/website/banana-runtime/package.json
!/website/banana-runtime/package-lock.json
!/website/banana-runtime/assets/
!/website/banana-runtime/layouts/
!/website/banana-runtime/scripts/
!/website/banana-runtime/static/
!/website/banana-runtime/i18n/
!/website/banana-runtime/data/
/website/banana-runtime/data/*
!/website/banana-runtime/data/*.json
!/website/banana-runtime/data/*.yaml

/website/deploy/*
!/website/deploy/*.example
!/website/deploy/*.service
!/website/deploy/*.timer
!/website/deploy/tex/
/website/deploy/tex/__pycache__/

/website/scripts/*
!/website/scripts/admin.mjs
!/website/scripts/backup.mjs
!/website/scripts/build-assets.mjs
!/website/scripts/build-course-catalog.mjs
!/website/scripts/build-document-search.mjs
!/website/scripts/build-pinyin-initials.py
!/website/scripts/check-release.mjs
!/website/scripts/export-readonly.mjs
!/website/scripts/import-danxi-reviews.mjs
!/website/scripts/import-guide-posts.mjs
!/website/scripts/import-lock.mjs
!/website/scripts/install-university-courses.mjs
!/website/scripts/setup-dev-catalog.mjs
!/website/scripts/verify-readonly.mjs

/website/tests/*
!/website/tests/*.mjs
!/website/tests/fixtures/
/website/tests/fixtures/*
!/website/tests/fixtures/image.png

**/.env
**/.env.*
**/__pycache__/
**/node_modules/
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
