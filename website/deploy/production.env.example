# Install privately as /etc/fudan-math/site.env (readable by service owner only).
# Fill domain and SMTP settings before starting. No real credentials in Git.
FUDAN_MODE=production
FUDAN_BIND=127.0.0.1
PORT=4318
FUDAN_PUBLIC_ORIGIN=https://math.example.org
FUDAN_TRUSTED_PROXIES=127.0.0.1
FUDAN_DATA_DIR=/var/lib/fudan-math
FUDAN_DB=/var/lib/fudan-math/library.sqlite
FUDAN_EMAIL_DOMAINS=fudan.edu.cn,m.fudan.edu.cn
FUDAN_MAIL_MODE=smtp
FUDAN_SMTP_HOST=
FUDAN_SMTP_PORT=587
FUDAN_SMTP_USER=
FUDAN_SMTP_PASS=
FUDAN_MAIL_FROM=
# Keep disabled until step 3 provides the isolated compiler. Existing PDFs work.
FUDAN_COMPILE_MODE=disabled
